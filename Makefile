PY ?= python3

.PHONY: verify test lint manifest manifest-check health run daemon clean help

help:
	@echo "verify   — канон: check.py (компиляция + тесты + гигиена + манифест)"
	@echo "test     — unittest-набор подробно"
	@echo "lint     — ruff check ."
	@echo "manifest — пересобрать release/manifest_sha256.txt (с шапкой GENERATED)"
	@echo "manifest-check — T17: пересобрать и свалить при расхождении с закоммиченным"
	@echo "health   — П55: A2A Agent Card ↔ живое поведение (честность вслух)"
	@echo "run      — make run TASK=\"текст задачи\""
	@echo "daemon   — автономный режим жизни"

verify:
	$(PY) scripts/check.py

test:
	$(PY) -m unittest discover -s tests -v

lint:
	ruff check .

manifest:
	@mkdir -p release
	@{ \
		echo "# GENERATED by make manifest — не правь руками (T17): правка без пересборки = красный CI"; \
		sha256sum universal_agent.py README.md CHANGELOG.md LICENSE CONTRIBUTING.md SECURITY.md pyproject.toml Makefile Dockerfile agent-card.json scripts/healthcheck.py; \
	} > release/manifest_sha256.txt
	@echo "release/manifest_sha256.txt обновлён (шапка GENERATED на месте)"

# T17 (repo-doctrine#24 → universal-agent): манифест свежести — генерится, а не пишется.
# Падение с точным приговором: «файлы изменились — пересобери манифест и закоммить».
manifest-check:
	@$(MAKE) --no-print-directory manifest
	@if ! git diff --exit-code --quiet -- release/manifest_sha256.txt; then \
		echo "МАНИФЕСТ УСТАРЕЛ: файлы изменились, а release/manifest_sha256.txt не пересобран."; \
		echo "Приговор T17: запусти make manifest и закоммить обновлённый манифест."; \
		git diff -- release/manifest_sha256.txt | head -30; \
		exit 1; \
	fi
	@head -1 release/manifest_sha256.txt | grep -q "# GENERATED" || { echo "ШАПКА GENERATED ОТСУТСТВУЕТ — манифест писали руками"; exit 1; }
	@echo "manifest-check: манифест свежий, шапка GENERATED на месте"

health:
	$(PY) scripts/healthcheck.py

run:
	$(PY) universal_agent.py task --task "$(TASK)"

daemon:
	$(PY) universal_agent.py daemon

clean:
	rm -rf __pycache__ tests/__pycache__ .ruff_cache
