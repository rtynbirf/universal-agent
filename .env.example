# Пример окружения ЦУА. Скопируйте в .env или экспортируйте вручную.
# ВАЖНО: настоящие ключи не храните в файлах проекта — только в окружении.

# --- ядро (выберите один вариант) ---
UA_LLM_BASE_URL=http://localhost:11434/v1        # Ollama
UA_LLM_MODEL=qwen3:30b-a3b
# UA_LLM_BASE_URL=http://localhost:8000/v1       # vLLM
# UA_LLM_MODEL=GLM-5.2
# UA_LLM_MODEL=DeepSeek-V4
# UA_LLM_MODEL=Kimi-K2.7-Code
# UA_LLM_API_KEY=                                # только для облачных API

# --- цикл ---
UA_MAX_STEPS=12
UA_MAX_OBSERVATION_CHARS=4000
UA_RECALL_TOP_K=6
UA_MEMORY_HALFLIFE_DAYS=14.0

# --- песочница ---
UA_EXEC_TIMEOUT_SEC=60
UA_EXEC_CPU_SEC=10
UA_EXEC_MEM_MB=512
UA_EXEC_NET_ISOLATE=false

# --- воля и органы ---
UA_DAEMON_POLL_SEC=5
UA_QUEUE_PATH=./task_queue.txt
UA_WORKSPACE_ROOT=./workspace
UA_MEMORY_DB=./memory/agent.db
UA_KNOWLEDGE_DIR=./knowledge
UA_RESULTS_LOG=./results.log
